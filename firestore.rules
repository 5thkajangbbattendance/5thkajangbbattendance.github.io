rules_version = '2';
// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
// Who can do what: roles, like Discord. The Owner makes roles on the Staff page; each role gives See or Change per area
// and See or Mark per attendance group, and a login gets everything its roles give together. Parade HQ saves that
// combined result on the login's staff record as `access` {read, write, see, mark}, and these rules check it.
// A login without `access` (before roles are set up) keeps its old duty, using the table in dutyAcc() below.
// The Owner always has everything. Only the Owner can change roles, staff records and logins.
service cloud.firestore {
  match /databases/{database}/documents {
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function me() { return staffDoc().data; }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && me().active == true;
    }
    function duty() { return me().duty; }
    function isOwner() { return isStaff() && duty() == 'owner'; }
    // The old duties, written as access (Parade HQ has the same table in dutyAccess). Only the matching branch is worked out,
    // which keeps each request well inside the rules' work limit. '-' stands for "none" (the emulator mishandles empty list literals).
    function dutyAcc() {
      let d = duty();
      return d == 'admin' ? {'read': ['run', 'reports', 'roster', 'changes', 'cs', 'web', 'notices', 'enquiries', 'orders', 'unisetup', 'drive', 'inv', 'invImport', 'invSheet', 'staff', 'activity'],
                             'write': ['run', 'roster', 'cs', 'web', 'notices', 'enquiries', 'orders', 'unisetup', 'drive', 'inv', 'invImport', 'invSheet'],
                             'see': ['officers', 'primers', 'helper', 'sq1', 'sq2', 'sq3', 'sq4'], 'mark': ['officers', 'primers', 'helper', 'sq1', 'sq2', 'sq3', 'sq4']}
        : d == 'commander' ? {'read': ['inv'], 'write': ['inv'], 'see': ['officers', 'primers', 'helper'], 'mark': ['officers', 'primers', 'helper']}
        : d == 'leader' ? {'read': ['inv'], 'write': ['inv'], 'see': ['sq' + string(me().get('squad', 0))], 'mark': ['sq' + string(me().get('squad', 0))]}
        : d == 'cs' ? {'read': ['cs'], 'write': ['cs'], 'see': ['-'], 'mark': ['-']}
        : d == 'web' ? {'read': ['web', 'notices', 'enquiries', 'orders', 'unisetup'], 'write': ['web', 'notices', 'enquiries', 'orders', 'unisetup'], 'see': ['-'], 'mark': ['-']}
        : d == 'uni' ? {'read': ['orders', 'unisetup', 'inv', 'invImport'], 'write': ['orders', 'unisetup', 'inv', 'invImport'], 'see': ['-'], 'mark': ['-']}
        : {'read': ['-'], 'write': ['-'], 'see': ['-'], 'mark': ['-']};
    }
    function acc() { return me().keys().hasAny(['access']) ? me().access : dutyAcc(); }
    function hasRead(x, a) { return a in x.read || a in x.write; }
    function canRead(a) { return isStaff() && (isOwner() || hasRead(acc(), a)); }
    function canWrite(a) { return isStaff() && (isOwner() || a in acc().write); }
    // Sees at least one attendance group (so it can read parades).
    function seesWith(x) { return x.see.hasAny(['officers', 'primers', 'helper', 'sq1', 'sq2', 'sq3', 'sq4']); }
    function seesAny() { return isStaff() && (isOwner() || seesWith(acc())); }
    // Reads the roll: anyone who sees attendance, the roster or Community Services.
    function readsWith(x) { return seesWith(x) || x.read.hasAny(['roster', 'cs']) || x.write.hasAny(['roster', 'cs']); }
    function readsPeople() { return isStaff() && (isOwner() || readsWith(acc())); }
    // A login that may change Uniform setup but not the Website may change only the payment methods and the Uniform page header.
    function uniSiteEdit() {
      return canWrite('unisetup') && !canWrite('web')
        && (resource == null
            ? request.resource.data.keys().hasOnly(['payMethods', 'uniformHero', 'updatedAt', 'updatedBy'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payMethods', 'uniformHero', 'updatedAt', 'updatedBy']));
    }
    // Uniform ordering is open when config/uniform says so (or has never been set up), the closing time has not passed,
    // and the order belongs to the current round.
    function uniformOpen() {
      let p = /databases/$(database)/documents/config/uniform;
      return !exists(p)
        ? request.resource.data.get('round', '') == ''
        : (get(p).data.open == true
           && (get(p).data.get('closesAtMs', 0) == 0 || request.time.toMillis() < get(p).data.get('closesAtMs', 0))
           && request.resource.data.get('round', '') == get(p).data.get('roundId', ''));
    }
    function idx() { return get(/databases/$(database)/documents/config/rosterIndex).data; }
    // The people this login may mark: everyone in the groups its access can mark.
    function markable() {
      let m = acc().mark;
      let i = idx();
      return ('officers' in m ? i.get('officers', ['-']) : ['-']).concat('primers' in m ? i.get('primers', ['-']) : ['-'])
        .concat('helper' in m ? i.get('helper', ['-']) : ['-']).concat('sq1' in m ? i.get('sq1', ['-']) : ['-'])
        .concat('sq2' in m ? i.get('sq2', ['-']) : ['-']).concat('sq3' in m ? i.get('sq3', ['-']) : ['-'])
        .concat('sq4' in m ? i.get('sq4', ['-']) : ['-']);
    }
    function noOwnerYet() { return !exists(/databases/$(database)/documents/config/owner); }
    function recoveryOk(key) {
      return key != '' && exists(/databases/$(database)/documents/config/recovery)
        && key == get(/databases/$(database)/documents/config/recovery).data.key;
    }

    // Which staff login is the Owner. Readable before sign-in so the first-time setup screen can appear.
    match /config/owner {
      allow get: if true;
      allow create: if request.auth != null && noOwnerYet()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.duty == 'owner';
      allow update: if request.auth != null && request.resource.data.uid == request.auth.uid
        && (isOwner() || recoveryOk(getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('recoveryKey', '')));
    }
    // The recovery key can never be read by the website, only checked by these rules.
    match /config/recovery { allow read: if false; allow write: if isOwner(); }
    match /config/org { allow read: if isStaff(); allow write: if isOwner(); }
    match /config/rosterIndex { allow read: if isStaff(); allow write: if canWrite('roster'); }
    // Roles: every posted login can read them (to show role names); only the Owner makes or changes them.
    match /roles/{id} { allow read: if isStaff(); allow write: if isOwner(); }

    match /staff/{uid} {
      // Everyone posted can see the staff board; a login can always read its own post (to learn it was revoked).
      allow read: if isStaff() || (request.auth != null && request.auth.uid == uid);
      allow create: if isOwner()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.duty == 'owner' && request.resource.data.active == true
            && (noOwnerYet() || recoveryOk(request.resource.data.get('recoveryKey', ''))));
      allow update, delete: if isOwner();
    }

    // Username -> sign-in address. Read one at a time before sign-in; only the Owner sets them.
    match /logins/{u} { allow get: if true; allow list: if false; allow write: if isOwner(); }
    match /people/{id} { allow read: if readsPeople(); allow write: if canWrite('roster'); }
    match /register/{id} { allow read: if canRead('roster'); allow write: if canWrite('roster'); }

    match /parades/{date} {
      // Only logins that see an attendance group can read parades; Run parades can change anything.
      allow read: if seesAny();
      allow create: if canWrite('run')
        || (isStaff() && request.resource.data.keys().hasOnly(['marks', 'status'])
            && request.resource.data.status == 'open'
            && request.resource.data.marks.keys().hasOnly(markable()));
      allow update: if canWrite('run')
        || (isStaff() && resource.data.get('status', 'open') == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks'])
            && request.resource.data.marks.diff(resource.data.get('marks', {})).affectedKeys().hasOnly(markable()));
      allow delete: if canWrite('run');
    }

    // Activity log: every save in Parade HQ adds one entry in the same save. Only in the signer's own name and with the
    // server's time; nobody can edit or delete an entry. The Owner turns it on (config/activity) after publishing these rules.
    match /config/activity { allow read: if isStaff(); allow write: if isOwner(); }
    match /activity/{id} {
      allow read: if canRead('activity');
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['by', 'byName', 'at', 'ts', 'areas', 'n', 'items'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName == me().name
        && request.resource.data.ts == request.time
        && request.resource.data.items is list && request.resource.data.items.size() <= 20;
    }

    // Change record: anyone posted can add an entry in their own name; nobody can edit or delete entries.
    match /changes/{id} {
      allow read: if canRead('changes');
      allow create: if isStaff() && request.resource.data.by == request.auth.uid;
    }

    // ---- Public website ----
    // Anyone can read published posts and the site details; only Owner, Admin and Website logins can change them.
    match /config/site { allow read: if true; allow write: if canWrite('web') || uniSiteEdit(); }
    match /posts/{id} {
      allow read: if resource.data.published == true || canRead('web');
      allow write: if canWrite('web');
    }
    match /team/{id} { allow read: if true; allow write: if canWrite('web'); }
    match /postImages/{id} {
      allow read: if canRead('web') || get(/databases/$(database)/documents/posts/$(id)).data.published == true;
      allow write: if canWrite('web');
    }
    // Recruitment form: anyone may send one enquiry with the expected fields and sizes; only Owner, Admin and Website logins can read or handle them.
    function shortText(d, k, max) { return d.get(k, '') is string && d.get(k, '').size() <= max; }
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['parentName', 'phone', 'email', 'childName', 'age', 'school', 'message', 'status', 'source', 'createdAt'])
        && request.resource.data.parentName is string && request.resource.data.parentName.size() > 0 && request.resource.data.parentName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && shortText(request.resource.data, 'email', 120) && shortText(request.resource.data, 'childName', 80)
        && shortText(request.resource.data, 'age', 3) && shortText(request.resource.data, 'school', 100)
        && shortText(request.resource.data, 'message', 1000)
        && request.resource.data.status == 'new' && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow read: if canRead('enquiries');
      allow update, delete: if canWrite('enquiries');
    }

    // Uniform order form: anyone may send one order with the expected fields; only Owner, Admin, Website and Uniform logins can read or handle orders.
    match /uniformItems/{id} { allow read: if true; allow write: if canWrite('unisetup'); }
    // Whether ordering is open, the current round and the message parents see. Rounds keep the open/close history.
    match /config/uniform { allow read: if true; allow write: if canWrite('unisetup'); }
    match /uniformRounds/{id} { allow read: if canRead('orders') || canRead('unisetup'); allow write: if canWrite('unisetup'); }
    // Where order photos are saved (the Google Drive web app link). Anyone who sees orders uses it; Photo storage settings changes it.
    match /config/drive { allow read: if canRead('orders'); allow write: if canWrite('drive'); }
    // The Google script link only, so the Uniform page can take payment proofs from parents.
    match /config/payproof { allow read: if true; allow write: if canWrite('drive') && (request.resource == null || (request.resource.data.keys().hasOnly(['url']) && request.resource.data.url is string && request.resource.data.url.matches('https://script[.]google[.]com/macros/s/[A-Za-z0-9_-]+/exec'))); }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'section', 'childName', 'squad', 'age', 'parentName', 'phone', 'notes', 'items', 'total', 'ref', 'round', 'payMethod', 'status', 'source', 'createdAt'])
        && shortText(request.resource.data, 'round', 40) && shortText(request.resource.data, 'payMethod', 60) && uniformOpen()
        && request.resource.data.kind in ['member', 'new'] && request.resource.data.section in ['pj', 'jr', 'sr']
        && request.resource.data.childName is string && request.resource.data.childName.size() > 0 && request.resource.data.childName.size() <= 80
        && request.resource.data.parentName is string && request.resource.data.parentName.size() > 0 && request.resource.data.parentName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && shortText(request.resource.data, 'squad', 20) && shortText(request.resource.data, 'age', 3) && shortText(request.resource.data, 'notes', 500)
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 12
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 20000
        && request.resource.data.status == 'new' && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow read: if canRead('orders');
      allow update: if canWrite('orders') || parentProof();
      allow delete: if canWrite('orders');
    }
    // A parent adds one payment proof to their own order (the company's Google script writes it after saving the file).
    // Nothing else on the order can change, earlier proofs stay as they are, and the status is never touched.
    function parentProof() {
      let d = request.resource.data;
      let had = ('payProof' in resource.data) && resource.data.payProof is list;
      let n = had ? resource.data.payProof.size() : 0;
      return resource.data.status in ['new', 'paid', 'ready']
        && d.diff(resource.data).affectedKeys().hasOnly(['payProof'])
        && d.payProof is list && d.payProof.size() == n + 1 && n < 10
        && (n == 0 || d.payProof[0:n] == resource.data.payProof)
        && proofEntry(d.payProof[n]);
    }
    function proofEntry(e) {
      return e is map && e.keys().hasOnly(['id', 'name', 'mime', 'thumb', 'at', 'by', 'parent'])
        && e.parent == true && e.by == 'Parent'
        && e.id is string && e.id.size() > 10 && e.id.size() <= 80
        && e.name is string && e.name.size() <= 120
        && e.mime in ['image/jpeg', 'image/png', 'application/pdf']
        && e.thumb is string && e.thumb.size() <= 60000
        && e.at is string && e.at.size() <= 40;
    }

    // ---- Notice board + forms ----
    // Published notices are public; drafts only for Owner, Admin and Website logins.
    match /notices/{id} {
      allow read: if resource.data.published == true || canRead('notices');
      allow write: if canWrite('notices');
    }
    // A form can be opened by anyone who has its link (so parents can fill it in); the list of forms is staff-only.
    match /forms/{id} {
      allow get: if true;
      allow list: if canRead('notices');
      allow write: if canWrite('notices');
    }
    // Anyone may send one response to a form that is open and not past its closing time; only staff can read them.
    function formOpen(fid) {
      let p = /databases/$(database)/documents/forms/$(fid);
      return exists(p) && get(p).data.get('status', '') == 'open'
        && (get(p).data.get('closesAtMs', 0) == 0 || request.time.toMillis() < get(p).data.get('closesAtMs', 0));
    }
    match /formResponses/{id} {
      allow create: if request.resource.data.keys().hasOnly(['formId', 'answers', 'ref', 'createdAt'])
        && request.resource.data.formId is string && request.resource.data.formId.size() > 0 && request.resource.data.formId.size() <= 60
        && formOpen(request.resource.data.formId)
        && request.resource.data.answers is map && request.resource.data.answers.size() <= 100
        && shortText(request.resource.data, 'ref', 12)
        && request.resource.data.createdAt == request.time;
      allow read: if canRead('notices');
      allow update, delete: if canWrite('notices');
    }

    // ---------- Inventory (Parade HQ > Company > Inventory) ----------
    // Inventory: See reads the stock list, Change edits it.
    function canInv() { return canWrite('inv'); }
    function wholeNum(d, k, max) { return d[k] is int && d[k] >= 0 && d[k] <= max; }
    function invItemOk(d) {
      return d.keys().hasOnly(['name', 'section', 'category', 'stock', 'threshold', 'priceSen', 'createdAt', 'updatedAt', 'by', 'byUid'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.section in ['prejunior', 'junior', 'senior', 'officers', 'primers']
        && d.category is string && d.category.size() > 0 && d.category.size() <= 40
        && wholeNum(d, 'stock', 100000) && wholeNum(d, 'threshold', 100000) && wholeNum(d, 'priceSen', 100000000)
        && shortText(d, 'createdAt', 40) && shortText(d, 'updatedAt', 40) && shortText(d, 'by', 80)
        && d.byUid == request.auth.uid;
    }
    match /inventoryItems/{id} {
      allow read: if canRead('inv');
      allow create: if canInv() && invItemOk(request.resource.data);
      allow update: if canInv() && invItemOk(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canInv();
    }
    // inventoryMeta/sync: a counter that goes up with every inventory save (the Google Sheet copies only when it changed).
    // inventoryMeta/sheet: the Google Sheet's link, when it last copied, and its web app link, written by the sheet's own login.
    match /inventoryMeta/{doc} {
      allow read: if canRead('inv');
      allow create, update: if canInv() && (
        (doc == 'sync' && request.resource.data.keys().hasOnly(['rev', 'at']) && request.resource.data.rev is int && shortText(request.resource.data, 'at', 40))
        || (doc == 'sheet' && request.resource.data.keys().hasOnly(['url', 'syncedAt', 'rev', 'hook'])
            && (request.resource.data.get('hook', '') == '' || request.resource.data.hook.matches('^https://script[.]google[.]com/macros/s/[A-Za-z0-9_-]{10,200}/exec$'))
            && request.resource.data.url is string && request.resource.data.url.matches('^https://docs[.]google[.]com/spreadsheets/.{1,200}$')
            && shortText(request.resource.data, 'syncedAt', 40) && request.resource.data.rev is int));
    }

    match /services/{id} { allow read: if readsPeople(); allow write: if canWrite('cs'); }
    match /csgroups/{id} { allow read: if readsPeople(); allow write: if canWrite('cs'); }
    match /cshours/{id} { allow read: if readsPeople(); allow write: if canWrite('cs'); }
  }
}
