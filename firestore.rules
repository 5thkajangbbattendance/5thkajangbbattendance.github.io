rules_version = '2';
// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
// Who can do what (matches the duties on the Staff page):
//   owner      everything, including staff, roster and the recovery key
//   admin      everything except issuing logins: every squad, roster, records, members data, website, community services
//   commander  marks officers, primers and helpers on open parades
//   leader     marks their own squad on open parades
//   cs         community services only (cannot read attendance)
//   web        the public website only: posts, team, notice board, forms, uniform items, site details, enquiries and uniform orders (cannot read attendance or members)
//   uni        uniform ordering only: orders, rounds, uniform items, the Uniform page header and payment methods
service cloud.firestore {
  match /databases/{database}/documents {
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function me() { return staffDoc().data; }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && me().active == true;
    }
    function duty() { return me().duty; }
    function isOwner() { return isStaff() && duty() == 'owner'; }
    function isAdmin() { return isStaff() && duty() in ['owner', 'admin']; }
    function canCS() { return isStaff() && duty() in ['owner', 'admin', 'cs']; }
    function canWeb() { return isStaff() && duty() in ['owner', 'admin', 'web']; }
    function canUni() { return isStaff() && duty() in ['owner', 'admin', 'web', 'uni']; }
    function notWeb() { return isStaff() && !(duty() in ['web', 'uni']); }
    // The Uniform login may change only the payment methods and the Uniform page header in the site details.
    function uniSiteEdit() {
      return isStaff() && duty() == 'uni'
        && (resource == null
            ? request.resource.data.keys().hasOnly(['payMethods', 'uniformHero', 'updatedAt', 'updatedBy'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payMethods', 'uniformHero', 'updatedAt', 'updatedBy']));
    }
    // Uniform ordering is open when config/uniform says so (or has never been set up), the closing time has not passed,
    // and the order belongs to the current round.
    function uniformOpen() {
      let p = /databases/$(database)/documents/config/uniform;
      return !exists(p)
        ? request.resource.data.get('round', '') == ''
        : (get(p).data.open == true
           && (get(p).data.get('closesAtMs', 0) == 0 || request.time.toMillis() < get(p).data.get('closesAtMs', 0))
           && request.resource.data.get('round', '') == get(p).data.get('roundId', ''));
    }
    function idx() { return get(/databases/$(database)/documents/config/rosterIndex).data; }
    function markable() {
      return duty() == 'commander'
        ? idx().officers.concat(idx().primers).concat(idx().helper)
        : (duty() == 'leader' ? idx().get('sq' + string(me().squad), []) : []);
    }
    function noOwnerYet() { return !exists(/databases/$(database)/documents/config/owner); }
    function recoveryOk(key) {
      return key != '' && exists(/databases/$(database)/documents/config/recovery)
        && key == get(/databases/$(database)/documents/config/recovery).data.key;
    }

    // Which staff login is the Owner. Readable before sign-in so the first-time setup screen can appear.
    match /config/owner {
      allow get: if true;
      allow create: if request.auth != null && noOwnerYet()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.duty == 'owner';
      allow update: if request.auth != null && request.resource.data.uid == request.auth.uid
        && (isOwner() || recoveryOk(getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('recoveryKey', '')));
    }
    // The recovery key can never be read by the website, only checked by these rules.
    match /config/recovery { allow read: if false; allow write: if isOwner(); }
    match /config/org { allow read: if isStaff(); allow write: if isOwner(); }
    match /config/rosterIndex { allow read: if isStaff(); allow write: if isAdmin(); }

    match /staff/{uid} {
      // Everyone posted can see the staff board; a login can always read its own post (to learn it was revoked).
      allow read: if isStaff() || (request.auth != null && request.auth.uid == uid);
      allow create: if isOwner()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.duty == 'owner' && request.resource.data.active == true
            && (noOwnerYet() || recoveryOk(request.resource.data.get('recoveryKey', ''))));
      allow update, delete: if isOwner();
    }

    // Username -> sign-in address. Read one at a time before sign-in; only the Owner sets them.
    match /logins/{u} { allow get: if true; allow list: if false; allow write: if isOwner(); }
    match /people/{id} { allow read: if notWeb(); allow write: if isAdmin(); }
    match /register/{id} { allow read, write: if isAdmin(); }

    match /parades/{date} {
      // Community Services and Website logins never see attendance.
      allow read: if isStaff() && !(duty() in ['cs', 'web', 'uni']);
      allow create: if isAdmin()
        || (isStaff() && request.resource.data.keys().hasOnly(['marks', 'status'])
            && request.resource.data.status == 'open'
            && request.resource.data.marks.keys().hasOnly(markable()));
      allow update: if isAdmin()
        || (isStaff() && resource.data.get('status', 'open') == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks'])
            && request.resource.data.marks.diff(resource.data.get('marks', {})).affectedKeys().hasOnly(markable()));
      allow delete: if isAdmin();
    }

    // Change record: anyone posted can add an entry in their own name; nobody can edit or delete entries.
    match /changes/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.by == request.auth.uid;
    }

    // ---- Public website ----
    // Anyone can read published posts and the site details; only Owner, Admin and Website logins can change them.
    match /config/site { allow read: if true; allow write: if canWeb() || uniSiteEdit(); }
    match /posts/{id} {
      allow read: if resource.data.published == true || canWeb();
      allow write: if canWeb();
    }
    match /team/{id} { allow read: if true; allow write: if canWeb(); }
    match /postImages/{id} {
      allow read: if canWeb() || get(/databases/$(database)/documents/posts/$(id)).data.published == true;
      allow write: if canWeb();
    }
    // Recruitment form: anyone may send one enquiry with the expected fields and sizes; only Owner, Admin and Website logins can read or handle them.
    function shortText(d, k, max) { return d.get(k, '') is string && d.get(k, '').size() <= max; }
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['parentName', 'phone', 'email', 'childName', 'age', 'school', 'message', 'status', 'source', 'createdAt'])
        && request.resource.data.parentName is string && request.resource.data.parentName.size() > 0 && request.resource.data.parentName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && shortText(request.resource.data, 'email', 120) && shortText(request.resource.data, 'childName', 80)
        && shortText(request.resource.data, 'age', 3) && shortText(request.resource.data, 'school', 100)
        && shortText(request.resource.data, 'message', 1000)
        && request.resource.data.status == 'new' && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if canWeb();
    }

    // Uniform order form: anyone may send one order with the expected fields; only Owner, Admin, Website and Uniform logins can read or handle orders.
    match /uniformItems/{id} { allow read: if true; allow write: if canUni(); }
    // Whether ordering is open, the current round and the message parents see. Rounds keep the open/close history.
    match /config/uniform { allow read: if true; allow write: if canUni(); }
    match /uniformRounds/{id} { allow read, write: if canUni(); }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'section', 'childName', 'squad', 'age', 'parentName', 'phone', 'notes', 'items', 'total', 'ref', 'round', 'payMethod', 'status', 'source', 'createdAt'])
        && shortText(request.resource.data, 'round', 40) && shortText(request.resource.data, 'payMethod', 60) && uniformOpen()
        && request.resource.data.kind in ['member', 'new'] && request.resource.data.section in ['pj', 'jr', 'sr']
        && request.resource.data.childName is string && request.resource.data.childName.size() > 0 && request.resource.data.childName.size() <= 80
        && request.resource.data.parentName is string && request.resource.data.parentName.size() > 0 && request.resource.data.parentName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && shortText(request.resource.data, 'squad', 20) && shortText(request.resource.data, 'age', 3) && shortText(request.resource.data, 'notes', 500)
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 12
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 20000
        && request.resource.data.status == 'new' && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if canUni();
    }

    // ---- Notice board + forms ----
    // Published notices are public; drafts only for Owner, Admin and Website logins.
    match /notices/{id} {
      allow read: if resource.data.published == true || canWeb();
      allow write: if canWeb();
    }
    // A form can be opened by anyone who has its link (so parents can fill it in); the list of forms is staff-only.
    match /forms/{id} {
      allow get: if true;
      allow list, write: if canWeb();
    }
    // Anyone may send one response to a form that is open and not past its closing time; only staff can read them.
    function formOpen(fid) {
      let p = /databases/$(database)/documents/forms/$(fid);
      return exists(p) && get(p).data.get('status', '') == 'open'
        && (get(p).data.get('closesAtMs', 0) == 0 || request.time.toMillis() < get(p).data.get('closesAtMs', 0));
    }
    match /formResponses/{id} {
      allow create: if request.resource.data.keys().hasOnly(['formId', 'answers', 'ref', 'createdAt'])
        && request.resource.data.formId is string && request.resource.data.formId.size() > 0 && request.resource.data.formId.size() <= 60
        && formOpen(request.resource.data.formId)
        && request.resource.data.answers is map && request.resource.data.answers.size() <= 100
        && shortText(request.resource.data, 'ref', 12)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if canWeb();
    }

    match /services/{id} { allow read: if notWeb(); allow write: if canCS(); }
    match /csgroups/{id} { allow read: if notWeb(); allow write: if canCS(); }
    match /cshours/{id} { allow read: if notWeb(); allow write: if canCS(); }
  }
}
